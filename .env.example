# Postgres: migrations connect as the owner; the app connects as hh_app (RLS enforced)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5433/household_health
DATABASE_URL=postgres://hh_app:change-me@127.0.0.1:5433/household_health
APP_DB_PASSWORD=change-me
# Neon deploy/env pull manages DATABASE_URL (pooled owner) and DATABASE_URL_UNPOOLED.
# Run npm run db:setup-neon to generate the restricted runtime URL below.
# APP_DATABASE_URL takes precedence over DATABASE_URL; keep owner credentials off the app host.
# APP_DATABASE_URL=postgresql://hh_app:...@ep-...-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:...@ep-....us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# LLM (LangChain ChatOpenAI). Swap provider in src/agent/llm.ts.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_LAB_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Observability (Langfuse). Leave keys empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# true = send structure/timings/token counts but redact prompt and completion text
LANGFUSE_REDACT_CONTENT=false

# Google OAuth Web application credentials (server-only; never commit real values).
AUTH_MODE=google
APP_ORIGIN=http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once with npm run email:setup-key. Store the same key on the app host.
# Gmail refresh tokens are encrypted in the database with this server-only key.
MAIL_ENCRYPTION_KEY=
# Authorized redirect URI: http://127.0.0.1:8080/api/auth/google/callback
# Gmail sending also needs: http://127.0.0.1:8080/api/email/gmail/callback
# AUTH_MODE=dev is an explicit localhost-only development/test bypass. Forbidden in production.
PORT=8080
# On an app host such as Render, set HOST=0.0.0.0, NODE_ENV=production, AUTH_MODE=google,
# and APP_ORIGIN to the public HTTPS origin. Dev authentication is localhost-only.
HOST=127.0.0.1
