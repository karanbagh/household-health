{
  "name": "household-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/src/server.js",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:setup-neon": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/setup-neon.ts",
    "email:setup-key": "node --import tsx scripts/setup-email-key.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/vitals.test.ts test/connection.test.ts && node --env-file=.env --import tsx --import ./test/setup-auth.ts --test test/integration.test.ts test/graph.test.ts test/members.test.ts test/labs.test.ts test/auth.test.ts test/mail.test.ts",
    "audit:verify": "tsx --env-file=.env scripts/verify-audit.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.4",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.18",
    "@langchain/openai": "1.5.13",
    "@langfuse/langchain": "5.11.1",
    "@langfuse/otel": "5.11.1",
    "@langfuse/tracing": "5.11.1",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@opentelemetry/sdk-node": "0.222.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
